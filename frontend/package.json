{
  "name": "web_app_test_react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build --mode production && shx mkdir -p ../backend/locales && shx cp -r src/i18n/* ../backend/locales/",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:e2e": "vite --mode e2e --port 5183 --strictPort",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:resample": "node scripts/verifyResampleSpectrum.mjs",
    "verify:pipeline-browser": "node scripts/verifyRecordingPipelineBrowser.mjs",
    "benchmark:flac": "node scripts/benchmarkFlacCompression.mjs"
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "^2.1.2",
    "@headlessui/react": "^2.2.9",
    "@mediapipe/tasks-vision": "^1.1.1",
    "colorjs.io": "^0.7.1",
    "dompurify": "^3.4.14",
    "i18next": "^26.5.11",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.1.9",
    "react-quill-new": "^3.7.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "baseline-browser-mapping": "^2.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "libflacjs": "^5.6.0",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  }
}
