{
  "name": "web_app_test_react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build --mode production && shx mkdir -p ../backend/locales && shx cp -r src/i18n/* ../backend/locales/",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:e2e": "vite --mode e2e --port 5183 --strictPort",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:resample": "node scripts/verifyResampleSpectrum.mjs",
    "verify:pipeline-browser": "node scripts/verifyRecordingPipelineBrowser.mjs",
    "benchmark:flac": "node scripts/benchmarkFlacCompression.mjs"
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "^2.1.2",
    "@headlessui/react": "^2.2.9",
    "@mediapipe/tasks-vision": "^0.10.32",
    "colorjs.io": "^0.6.1",
    "dompurify": "^3.4.14",
    "i18next": "^25.5.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.0.0",
    "react-quill-new": "^3.7.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "baseline-browser-mapping": "^2.9.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "libflacjs": "^5.6.0",
    "shx": "^0.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
