# Database (own schema — safe to point at the same MySQL server as the main
# app's DB, just a different DB_NAME; nothing is shared/joined across them)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=booking_service
# Only needed when running mounted inside a host app's process (see "Running
# mounted inside another process" below) and that host app's own .env
# already defines DB_NAME for its own database — set BOOKING_DB_NAME there
# instead so the two don't collide in the shared process.env. Standalone use
# (this file) never needs it; DB_NAME above is enough.
# BOOKING_DB_NAME=

# HTTP
PORT=4100
# Public origin this service is reachable at — used to build hosted booking
# page URLs (e.g. in webhook payloads / logs) and the confirmation email's
# location photo (public/images/CVUT-building.jpg), which email clients load
# from the recipient's device, so this must be a real public URL (not
# localhost) in production or the photo won't show up in the email. No
# trailing slash.
PUBLIC_BASE_URL=http://localhost:4100
# Comma-separated browser origins allowed to call the admin API directly
# (normally none — the admin API is meant to be called server-to-server; the
# public/*  routes are same-origin since booking-service serves its own pages).
CORS_ORIGIN=

# Email (own SMTP config — independent of any consuming app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Booking
# Set to "true" for local dev/testing to skip real SMTP sends — each email
# is instead written as an HTML file to logs/dev-emails/ so you can open it
# in a browser and see exactly what would have been sent. Leave unset (or
# any value other than "true") in production.
EMAIL_DRY_RUN=

# Google Calendar sync (optional — booking sync/CRUD still works without
# these, Calendar push is simply skipped and logged). See README's "Google
# Calendar sync" section for the one-time GCP service-account setup steps.
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH: full path to the downloaded service-account
# .json key. Convention: drop the file into booking-service/google-calendar/
# (already git-ignored for this) and point this at it, e.g.
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/booking-service/google-calendar/your-key-file.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
# GOOGLE_CALENDAR_ID: the calendar's "Calendar ID" from Google Calendar's own
# Settings > Integrate calendar page (README step 7) — your email address for
# a primary calendar, or an xxxx@group.calendar.google.com id for a
# dedicated one.
GOOGLE_CALENDAR_ID=
