# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=task_protocoller

# HTTP
PORT=3000
# Where uploaded recordings/files are stored, and where the locales bundle
# used by emailService.js lives in production (see its comment: falls back
# to frontend/src/i18n in dev if unset).
DATA_PATH=./uploads
I18N_PATH=./locales

# Admin JWT signing secret — any long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the same secret across environments (dev/test/production).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Browser origins allowed to read API responses (comma-separated). The dev
# frontend runs on Vite's default port 5173, forced to HTTPS by
# vite.config.js; Vite falls back to 5174/5175/... if 5173 is taken, so a
# few fallback ports are worth allow-listing too.
CORS_ORIGIN=https://localhost:5173,https://localhost:5174,https://localhost:5175

# Gmail config for sending emails — use a 16-character Google App Password
# (Google Account → Security → App Passwords), not your regular password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Set to "true" to let a participant reopen their link and re-run/re-complete
# a protocol they already finished. Leave unset/"false" in production — a
# finished assignment should be terminal (see src/config/constants.js).
ALLOW_PROTOCOL_RERUN=

# Follow-up appointment booking (optional — see README.md's "Follow-up
# Booking Integration" section, and booking-service/README.md). Leave all of
# this unset if you're not using the booking feature; it's skipped cleanly.
# Get these three from `npm run tenant:create -- "Your Project"` in
# booking-service/ (booking-service must be running separately first).
BOOKING_SERVICE_URL=http://localhost:4100
BOOKING_SERVICE_TENANT_ID=
BOOKING_SERVICE_API_KEY=
BOOKING_SERVICE_LINK_SIGNING_SECRET=
# Optional — all have sensible defaults, see bookingServiceClient.js:
# BOOKING_SERVICE_RESOURCE_SLUG=standardized-room-retest
# BOOKING_SERVICE_RESOURCE_NAME=Standardized Room Retest
# BOOKING_SERVICE_DEFAULT_DURATION_MIN=45
# BOOKING_SERVICE_DEFAULT_LOCATION=

# Only for the "mounted" deployment (booking-service running inside this
# same process instead of standalone — see booking-service/README.md,
# "Running mounted inside another process"). Not needed for a normal
# standalone setup (the default). If you do enable it, BOOKING_DB_NAME
# names booking-service's own database and must differ from DB_NAME above,
# since mounted mode shares this process's env between both apps.
# MOUNT_BOOKING_SERVICE=true
# BOOKING_DB_NAME=
