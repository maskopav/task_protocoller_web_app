{
  "name": "backend",
  "version": "1.0.0",
  "description": "This backend module initializes and manages the database for the **React Voice Recorder & Admin Task Editor** app.  \r It connects to a MariaDB database and automatically runs SQL scripts to populate base tables (`task_types`, `tasks`).",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test:reset": "node --env-file=.env.test src/runInit.js && node --env-file=.env.test src/runE2ESeed.js",
    "db:views": "node src/applyViews.js",
    "db:uploads": "node src/applyUploads.js",
    "backup": "node src/runBackup.js",
    "db:sql": "node --env-file=.env src/dbConsole.js",
    "start:test": "node --env-file=.env.test server.js",
    "db:schema:diff": "node scripts/schema/compareSchemas.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "i18next": "^26.5.11",
    "i18next-fs-backend": "^2.6.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.2.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26"
  }
}
